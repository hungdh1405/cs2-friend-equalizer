# Shared PIN that unlocks the app (exactly 6 digits).
NUXT_APP_PIN=123456

# Secret used to encrypt the session cookie. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=replace-with-a-random-32-plus-character-string

# Discord bot — from the Discord Developer Portal (Bot tab for the token, General
# Information tab for the public key). The bot token is a genuine secret (wrangler secret
# put in production); the public key and channel ID are not secrets but still live here for
# local dev convenience.
NUXT_DISCORD_BOT_TOKEN=replace-with-your-bot-token
NUXT_DISCORD_PUBLIC_KEY=replace-with-your-app-public-key
NUXT_DISCORD_CHANNEL_ID=replace-with-your-channel-id

# Fixed vote target for the weekly event (defaults to 10 if unset).
NUXT_EVENT_TARGET_VOTES=10

# When true, the bot logs what it *would* send instead of actually posting to Discord —
# use this while testing scheduled tasks/interactions locally so you don't spam the real
# channel or ping the real Hosts.
NUXT_DISCORD_DRY_RUN=false
